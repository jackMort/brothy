---
// The front page demo, staged like a desktop shot: a still wallpaper in the brothy palette and a frosted terminal
// window floating on it, the recorded tour (site/public/casts/tour-{dark,light}.cast) playing inside on a clear
// canvas (src/scripts/player.ts), so the glass shows behind the text. It swaps casts with the theme, keeping the time.
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<section class="stage not-content" id="tour" data-head="Tour">
  <div class="wall" aria-hidden="true"></div>
  <div
    class="win"
    data-cast
    data-poster="4.4"
    data-dark={`${base}/casts/tour-dark.cast`}
    data-light={`${base}/casts/tour-light.cast`}
    tabindex="0"
    role="group"
    aria-label="A one-minute tour of brothy, recorded from the real UI. Space plays or pauses, the arrows seek."
  >
    <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span>brothy ~/examples</span><span></span></div>
    <div class="screen"><canvas aria-hidden="true"></canvas></div>
    <div class="ctl">
      <button type="button" data-play>play</button>
      <span class="track" data-bar></span>
      <span data-time>0:00</span>
      <span class="k"><kbd>space</kbd> play <kbd>←</kbd> <kbd>→</kbd> seek</span>
    </div>
  </div>
  <p class="cast-note">Recorded from the real UI: reading a note, following links, the switcher, themes, live reload and zen.</p>
</section>

<script>
  import { mountCast } from "../scripts/player"
  const el = document.querySelector<HTMLElement>("[data-cast]")
  if (el) mountCast(el).catch(() => el.classList.add("is-broken"))
</script>
