---
// The front page is brothy's welcome page: the wordmark over the bowl with its steam (art.json, drawn from the app's
// own WORDMARK and welcomeArt by scripts/site-art.ts), the title and tagline, the actions as keycaps (`attrs.data-key`
// names the key) and a "Start here" list that ↑ ↓ ⏎ move through, as the welcome page's recent projects do.
import { getEntry } from "astro:content"
import art from "../art.json"

const { data } = Astro.locals.starlightRoute.entry
const { tagline, actions = [] } = data.hero ?? {}
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const START = ["getting-started/install", "getting-started/quick-start", "keys", "usage/reading", "themes/theme-picker", "ai/setup"]
const start = await Promise.all(
  START.map(async (id) => {
    const e = await getEntry("docs", id)
    if (!e) throw new Error(`Hero: no docs page ${id}`)
    const words = (e.body ?? "")
      .replace(/```[\s\S]*?```/g, " ")
      .split(/\s+/)
      .filter(Boolean).length
    return { id, title: e.data.title, href: `${base}/${id}/`, min: Math.max(1, Math.round(words / 220)) }
  }),
)
---

<section class="welcome" data-head="Welcome">
  <div class="art" aria-hidden="true">
    <svg class="wordmark" viewBox={`0 0 ${art.wordmark.w} ${art.wordmark.h}`}><path d={art.wordmark.d} /></svg>
    <svg class="bowl" viewBox={`0 0 ${art.bowl.w} ${art.bowl.h}`}>
      <g class="b-steam" data-steam></g>
      <path class="b-broth" d={art.bowl.broth} />
      <path class="b-edge" d={art.bowl.edge} />
      <path class="b-body" d={art.bowl.body} />
    </svg>
  </div>
  <h1 id="_top" data-page-title set:html={data.title} />
  {tagline && <p class="sub" set:html={tagline} />}
  {
    actions.length > 0 && (
      <ul class="caps">
        {actions.map(({ link, text, attrs }) => (
          <li>
            <a href={link}>{attrs?.["data-key"] && <kbd>{attrs["data-key"]}</kbd>} {text}</a>
          </li>
        ))}
      </ul>
    )
  }
  <nav class="start" aria-label="Start here" data-start>
    <div class="hd"><span>Start here</span><span>{start.length}</span></div>
    <ol>
      {
        start.map((s, i) => (
          <li>
            <a href={s.href} class:list={{ on: i === 0 }}>
              <span class="t">{s.title.toLowerCase()}</span>
              <span class="path">{s.id}</span>
              <span class="min">{s.min} min</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="ft"><kbd>↑</kbd> <kbd>↓</kbd> move <kbd>⏎</kbd> open</div>
  </nav>
</section>

<script>
  import { cell, steam } from "../art.json" // named imports: only the steam frames reach the page's script
  import { mountSteam } from "../scripts/steam"
  const g = document.querySelector<SVGGElement>("[data-steam]")
  if (g) mountSteam(g, steam, cell)
</script>
