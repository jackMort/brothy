{
  // Rules switched off below fight a deliberate pattern; the reason is on the line above each.
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "site/src/**",
      "site/*.mjs",
      "*.json",
      "*.jsonc",
      "!site/dist",
      "!**/node_modules",
      "!docs",
      "!**/*.cast",
      "!**/*.md",
      "!**/*.mdx",
      "!site/src/art.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": { "formatter": { "expand": "auto" } },
  "css": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    // .astro frontmatter is linted without its template (false unused imports); the site CSS overrides Starlight with !important
    "includes": ["**", "!**/*.astro", "!**/*.css"],
    "rules": {
      "preset": "recommended",
      "a11y": {
        // the UI is a terminal: OpenTUI <box> mouse handlers have no DOM semantics, focus or keyboard-event pairing
        "noStaticElementInteractions": "off",
        "useKeyWithMouseEvents": "off"
      },
      "style": {
        // indexed reads are guarded by noUncheckedIndexedAccess and checked at the loop or length test beside them (818 sites)
        "noNonNullAssertion": "off",
        // short `a + b` string joins are the house style; the autofix is unsafe and would churn 179 sites
        "useTemplate": "off"
      },
      "suspicious": {
        // terminal rows and cells are positional and have no identity beyond their index
        "noArrayIndexKey": "off",
        // `EditResult | void` types the `edit` stub, which may return nothing (tests and the real editor runner differ)
        "noConfusingVoidType": "off",
        // the text sanitisers match control characters on purpose
        "noControlCharactersInRegex": "off",
        // `while ((m = re.exec(s)))`, `x ??= ...` caches and `(budget -= n) < 0` are compact idioms used in hot paths and tests
        "noAssignInExpressions": "off",
        // forEach arrows that return a push or a toggle are the one-liner form of a loop body; the result is never read
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        // `(hits++, response)` stubs in tests and `(clearTimeout(t), resolve(v))` callbacks are deliberate one-expression bodies
        "noCommaOperator": "off"
      }
    }
  },
  "overrides": [
    {
      // effects mount once and close over the context's refs; the dependency lists are intentionally empty or partial
      "includes": ["src/app/effects.ts"],
      "linter": { "rules": { "correctness": { "useExhaustiveDependencies": "off" } } }
    },
    {
      // useAppHarness, useXdgDir, useTmp… are bun:test setup helpers (they register beforeEach/afterEach), not React hooks
      "includes": ["tests/**"],
      "linter": { "rules": { "correctness": { "useHookAtTopLevel": "off" } } }
    }
  ],
  "assist": { "enabled": false }
}
